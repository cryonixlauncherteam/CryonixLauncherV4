<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Cryonix Midnight Blue Theme -->
    <style name="AppTheme" parent="@style/Theme.AppCompat.NoActionBar">
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="android:windowContentOverlay">@null</item>

        <item name="colorPrimary">@color/primary_accent</item>
        <item name="colorPrimaryDark">@color/background_status_bar</item>
        <item name="colorAccent">@color/primary_accent</item>

        <item name="android:windowBackground">@color/background_app</item>
        <item name="android:colorBackground">@color/background_app</item>

        <item name="android:textColorPrimary">@color/primary_text</item>
        <item name="android:textColorSecondary">@color/secondary_text</item>
        <item name="android:textColorTertiary">@color/tertiary_text</item>

        <item name="android:statusBarColor">@color/background_status_bar</item>
        <item name="android:navigationBarColor">@color/background_bottom_bar</item>

        <item name="preferenceTheme">@style/CryonixPreferenceTheme</item>
        <item name="alertDialogTheme">@style/CryonixAlertDialogTheme</item>
        <item name="dialogTheme">@style/CryonixDialogTheme</item>

        <item name="android:textSize">@dimen/_12ssp</item>
    </style>

    <style name="CryonixAlertDialogTheme" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:textColorPrimary">@color/primary_text</item>
        <item name="android:textColorSecondary">@color/secondary_text</item>
        <item name="colorAccent">@color/primary_accent</item>
        <item name="android:windowMinWidthMajor">35%</item>
        <item name="android:windowMinWidthMinor">45%</item>
        <item name="android:windowIsFloating">true</item>
    </style>



    <style name="LauncherFragment_Divider">
        <item name="android:layout_width">1dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:background">@color/divider</item>
    </style>

    <style name="LauncherMenuButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_button_secondary</item>
    </style>

    <style name="LauncherMenuButton.Universal" parent="LauncherMenuButton">
        <item name="android:layout_height">@dimen/_52sdp</item>
    </style>

    <style name="ThickDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/divider</item>
    </style>

    <item name="dimension_tracker" type="id" />
    <style name="DimensionTracker">
        <item name="android:id">@id/dimension_tracker</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
    </style>

    <style name="CryonixPreferenceCategory" parent="@style/Preference.Category">
        <item name="android:layout">@layout/preference_category_cryonix</item>
    </style>

    <style name="CryonixPreferenceItem" parent="@style/Preference">
        <item name="android:layout">@layout/preference_item_cryonix</item>
    </style>

    <style name="CryonixPreferenceTheme" parent="@style/PreferenceThemeOverlay.v14.Material">
        <item name="preferenceCategoryStyle">@style/CryonixPreferenceCategory</item>
        <item name="preferenceStyle">@style/CryonixPreferenceItem</item>
    </style>
</resources>