<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/_12sdp" />
            <solid android:color="#1B3454" />
            <stroke android:width="1dp" android:color="@color/cryonix_accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/_8sdp" />
            <solid android:color="@color/cryonix_surface" />
            <stroke android:width="1dp" android:color="@color/cryonix_border" />
        </shape>
    </item>
</selector>
