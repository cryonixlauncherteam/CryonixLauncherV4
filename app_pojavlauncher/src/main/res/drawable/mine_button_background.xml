<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/primary_accent_pressed" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#65A7FF" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#25348BFF" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#243C5D" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/primary_accent" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#65A7FF" />
        </shape>
    </item>
</selector>
