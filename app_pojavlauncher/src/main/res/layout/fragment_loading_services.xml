<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app"
    android:padding="24dp">
    <LinearLayout
        android:layout_width="360dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_dialog"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="28dp">
        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="Cryonix Launcher"
            android:src="@drawable/cryonixlauncher" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Preparing your launcher"
            android:textColor="@color/primary_text"
            android:textSize="18sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/loading_step_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Initializing services..."
            android:textColor="@color/secondary_text"
            android:textSize="13sp" />
        <ProgressBar
            android:id="@+id/services_progress_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:layout_marginTop="22dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/primary_accent" />
    </LinearLayout>
</FrameLayout>
