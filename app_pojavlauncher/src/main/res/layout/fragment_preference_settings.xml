<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/background_app">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/settings_back_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Back" />

        <Button
            android:id="@+id/settings_home_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Home" />
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="false"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button android:id="@+id/cat_video_button" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Video" />
            <Button android:id="@+id/cat_controls_button" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Controls" />
            <Button android:id="@+id/cat_java_button" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Java" />
            <Button android:id="@+id/cat_misc_button" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Misc" />
            <Button android:id="@+id/cat_experimental_button" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Experimental" />
        </LinearLayout>
    </HorizontalScrollView>

    <FrameLayout
        android:id="@+id/preference_fragment_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
