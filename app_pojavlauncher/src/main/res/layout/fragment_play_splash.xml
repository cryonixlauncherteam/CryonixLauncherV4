<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app">

    <!-- Scenic Backdrop Image -->
    <ImageView
        android:id="@+id/splash_bg_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/img"
        android:contentDescription="@null" />

    <!-- Soft Overlay Gradient -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#44000000" />

    <!-- Account & Version Info Header Overlay -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="32dp"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/account_name_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-bold"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/account_type_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#9BA8BA"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/splash_version_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_chip"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:textColor="#168BFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Centered PLAY Button -->
    <com.kdt.mcgui.MineButton
        android:id="@+id/splash_play_button"
        android:layout_width="220dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_sidebar_selected"
        android:drawableStart="@drawable/ic_px_play"
        android:gravity="center"
        android:paddingHorizontal="16dp"
        android:text="PLAY"
        android:textColor="@color/primary_text"
        android:textSize="20sp"
        android:textStyle="bold" />

</FrameLayout>
