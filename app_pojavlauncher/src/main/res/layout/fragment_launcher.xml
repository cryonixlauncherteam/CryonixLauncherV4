<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fragment_menu_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app"
    android:padding="12dp">

    <!-- Scrollable Main Content -->
    <ScrollView
        android:id="@+id/quick_actions_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="10dp"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@id/bottom_controls_container"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Instances Header Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_px_cube"
                    app:tint="@color/primary_text" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/instances"
                        android:textColor="@color/primary_text"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Manage your Minecraft instances"
                        android:textColor="@color/secondary_text"
                        android:textSize="11sp" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/create_instance_button"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_sidebar_selected"
                    android:contentDescription="@string/create_instance"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_px_plus"
                    app:tint="@color/primary_text" />
            </LinearLayout>

            <!-- Selected Instance Main Card -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/selected_instance_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/background_card"
                android:padding="12dp">

                <ImageView
                    android:id="@+id/instance_preview_image"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/img"
                    app:layout_constraintTop_toTopOf="parent" />

                <LinearLayout
                    android:id="@+id/selected_instance_info_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    app:layout_constraintTop_toBottomOf="@+id/instance_preview_image">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/selected_instance_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1.12.2"
                            android:textColor="@color/primary_text"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/selected_instance_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="● Ready"
                            android:textColor="@color/success_color"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <com.kdt.mcgui.mcVersionSpinner
                        android:id="@+id/mc_version_spinner"
                        android:layout_width="140dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_chip"
                        android:drawableEnd="@drawable/spinner_arrow" />
                </LinearLayout>

                <!-- Prominent Launch Button -->
                <com.kdt.mcgui.MineButton
                    android:id="@+id/play_button"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_button_launch"
                    android:drawableStart="@drawable/ic_px_play"
                    android:gravity="center"
                    android:text="@string/main_play"
                    android:textAllCaps="true"
                    android:textColor="@color/minebutton_text_color"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toBottomOf="@+id/selected_instance_info_row" />

                <!-- Action Buttons Grid -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical"
                    app:layout_constraintTop_toBottomOf="@+id/play_button">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginBottom="4dp"
                        android:orientation="horizontal">

                        <com.kdt.mcgui.LauncherMenuButton
                            android:id="@+id/edit_profile_button"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_button_secondary"
                            android:drawableStart="@drawable/ic_px_edit"
                            android:text="Edit"
                            android:textColor="@color/primary_text" />

                        <com.kdt.mcgui.LauncherMenuButton
                            android:id="@+id/duplicate_instance_button"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_button_secondary"
                            android:drawableStart="@drawable/ic_px_duplicate"
                            android:text="Duplicate"
                            android:textColor="@color/primary_text" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:orientation="horizontal">

                        <com.kdt.mcgui.LauncherMenuButton
                            android:id="@+id/delete_instance_button"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_button_secondary"
                            android:drawableStart="@drawable/ic_px_trash"
                            android:text="Delete"
                            android:textColor="@color/primary_text" />

                        <com.kdt.mcgui.LauncherMenuButton
                            android:id="@+id/open_files_button"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_button_secondary"
                            android:drawableStart="@drawable/ic_px_folder"
                            android:text="Open folder"
                            android:textColor="@color/primary_text" />
                    </LinearLayout>
                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- AI Assistant Card -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/ai_assistant_card"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/background_card"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:id="@+id/ai_icon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_sidebar_selected"
                    android:padding="5dp"
                    android:src="@drawable/ic_px_sparkles"
                    app:tint="@color/primary_text"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/ai_icon"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AI Assistant"
                        android:textColor="@color/primary_text"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Follow AI Commands To setup Launcher properly!"
                        android:textColor="@color/secondary_text"
                        android:textSize="10sp" />
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Quick Bar -->
    <LinearLayout
        android:id="@+id/bottom_controls_container"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_bottom_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.kdt.mcgui.LauncherMenuButton
            android:id="@+id/news_button"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_secondary"
            android:drawableStart="@drawable/ic_px_book"
            android:text="@string/mcl_tab_wiki"
            android:textColor="@color/primary_text"
            android:textSize="11sp" />

        <com.kdt.mcgui.LauncherMenuButton
            android:id="@+id/custom_control_button"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_secondary"
            android:drawableStart="@drawable/ic_px_gamepad"
            android:text="@string/mcl_option_customcontrol"
            android:textColor="@color/primary_text"
            android:textSize="11sp" />

        <com.kdt.mcgui.LauncherMenuButton
            android:id="@+id/install_jar_button"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_secondary"
            android:drawableStart="@drawable/ic_px_java_run"
            android:text="@string/main_install_jar_file"
            android:textColor="@color/primary_text"
            android:textSize="11sp" />

        <View
            android:id="@+id/social_media_button"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <View
            android:id="@+id/share_logs_button"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <View
            android:id="@+id/_background_display_view"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Floating Cryonix Assistant Circle (Bottom Right) -->
    <ImageButton
        android:id="@+id/floating_assistant_button"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="60dp"
        android:background="@drawable/bg_floating_assistant"
        android:contentDescription="Cryonix Assistant"
        android:elevation="6dp"
        android:padding="10dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_px_sparkles"
        app:tint="@color/primary_text"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
