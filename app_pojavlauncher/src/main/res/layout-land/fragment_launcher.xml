<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fragment_menu_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app"
    android:padding="8dp">

    <!-- FAR LEFT: Vertical Navigation Sidebar -->
    <LinearLayout
        android:id="@+id/sidebar_container"
        android:layout_width="56dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_card_elevated"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingVertical="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Top Cryonix Logo Badge -->
        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginBottom="16dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/cr" />

        <!-- Home (Active) -->
        <ImageButton
            android:id="@+id/sidebar_home_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_sidebar_selected"
            android:contentDescription="@string/mcl_tab_home"
            android:scaleType="centerInside"
            android:src="@drawable/ic_px_home"
            app:tint="@color/primary_text" />

        <!-- Accounts / Profile -->
        <ImageButton
            android:id="@+id/sidebar_accounts_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_button_secondary"
            android:contentDescription="Accounts"
            android:scaleType="centerInside"
            android:src="@drawable/ic_px_accounts"
            app:tint="@color/primary_text" />

        <!-- Instances / Mods -->
        <ImageButton
            android:id="@+id/custom_control_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_button_secondary"
            android:contentDescription="@string/mcl_option_customcontrol"
            android:scaleType="centerInside"
            android:src="@drawable/ic_px_cube"
            app:tint="@color/primary_text" />

        <!-- Downloads / Media -->
        <ImageButton
            android:id="@+id/install_jar_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_button_secondary"
            android:contentDescription="@string/main_install_jar_file"
            android:scaleType="centerInside"
            android:src="@drawable/ic_px_download"
            app:tint="@color/primary_text" />

        <View
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Settings / Sliders (Bottom) -->
        <ImageButton
            android:id="@+id/sidebar_settings_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_button_secondary"
            android:contentDescription="@string/mcl_options"
            android:scaleType="centerInside"
            android:src="@drawable/ic_px_sliders"
            app:tint="@color/primary_text" />

        <ImageButton
            android:id="@+id/news_button"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/social_media_button"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/share_logs_button"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- CENTER AREA: Featured Banner & News Cards -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main_dashboard_area"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/right_panel"
        app:layout_constraintStart_toEndOf="@+id/sidebar_container"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Top Header Social Row -->
        <LinearLayout
            android:id="@+id/dashboard_top_header"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Social Media Icons -->
            <ImageView
                android:id="@+id/discord_button"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginEnd="10dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Discord"
                android:src="@drawable/ic_discord" />

            <ImageView
                android:id="@+id/youtube_button"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginEnd="10dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="YouTube"
                android:src="@drawable/ic_youtube" />

            <!-- Online Player Status Badge -->
            <TextView
                android:id="@+id/online_players_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="🟢 1,248 using Cryonix"
                android:textColor="@color/primary_text"
                android:textSize="10sp" />

            <!-- Branding -->
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="Cryonix Launcher V4"
                android:textColor="@color/secondary_text"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Notification Badge -->
            <ImageButton
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Notifications"
                android:src="@drawable/ic_px_bell"
                app:tint="@color/secondary_text" />

        </LinearLayout>

        <!-- Featured Instance Banner Card -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/featured_instance_card"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/background_card"
            android:padding="12dp"
            app:layout_constraintBottom_toTopOf="@+id/news_cards_row"
            app:layout_constraintTop_toBottomOf="@+id/dashboard_top_header">

            <!-- Banner Backdrop Image -->
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/img"
                android:alpha="0.35"
                android:contentDescription="@null" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/featured_instance_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Minecraft 1.20.1"
                    android:textColor="@color/primary_text"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:background="@drawable/bg_sidebar_selected"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:text="Custom Modpack"
                    android:textColor="@color/primary_text"
                    android:textSize="9sp" />

                <TextView
                    android:layout_width="280dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="10dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="2"
                    android:text="The Minecraft Trails &amp; Tales update introduces new ways to tell stories and explore options."
                    android:textColor="@color/secondary_text"
                    android:textSize="10sp" />

                <!-- Centered Green LAUNCH Button -->
                <com.kdt.mcgui.MineButton
                    android:id="@+id/play_button"
                    android:layout_width="180dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_sidebar_selected"
                    android:drawableStart="@drawable/ic_px_play"
                    android:gravity="center"
                    android:text="LAUNCH 1.20.1"
                    android:textColor="@color/primary_text"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Bottom Row News & Feature Cards -->
        <LinearLayout
            android:id="@+id/news_cards_row"
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent">

            <!-- Card 1 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/background_card"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Launcher Release"
                    android:textColor="@color/primary_text"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Cryonix V4 official release announcement."
                    android:textColor="@color/secondary_text"
                    android:textSize="9sp" />
            </LinearLayout>

            <!-- Card 2 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/background_card"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="New Combat Mod"
                    android:textColor="@color/primary_text"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Custom combat mechanics update."
                    android:textColor="@color/secondary_text"
                    android:textSize="9sp" />
            </LinearLayout>

            <!-- Card 3 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/background_card"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="New Cosmetics"
                    android:textColor="@color/primary_text"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Custom capes and skins available."
                    android:textColor="@color/secondary_text"
                    android:textSize="9sp" />
            </LinearLayout>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- RIGHT PANEL: User Profile & Instance Launch Card -->
    <LinearLayout
        android:id="@+id/right_panel"
        android:layout_width="220dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- User Profile Card -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/profile_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/background_card"
            android:padding="10dp">

            <ImageView
                android:id="@+id/user_avatar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/cr"
                android:contentDescription="User Avatar"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/user_profile_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="docy"
                android:textColor="@color/primary_text"
                android:textSize="13sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/user_avatar" />

            <com.kdt.mcgui.MineButton
                android:id="@+id/manage_account_button"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_button_secondary"
                android:gravity="center"
                android:text="Manage Account"
                android:textColor="@color/primary_text"
                android:textSize="10sp"
                app:layout_constraintTop_toBottomOf="@+id/user_profile_name" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Selected Instance Launch Card -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/selected_instance_panel"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:layout_weight="1"
            android:background="@drawable/background_card"
            android:padding="8dp">

            <TextView
                android:id="@+id/selected_instance_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1.12.2"
                android:textColor="@color/primary_text"
                android:textSize="12sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/selected_instance_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● Ready"
                android:textColor="@color/success_color"
                android:textSize="10sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/selected_instance_title" />

            <com.kdt.mcgui.mcVersionSpinner
                android:id="@+id/mc_version_spinner"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_chip"
                app:layout_constraintTop_toBottomOf="@+id/selected_instance_status" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical"
                app:layout_constraintTop_toBottomOf="@+id/mc_version_spinner">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:layout_marginBottom="4dp"
                    android:orientation="horizontal">

                    <com.kdt.mcgui.LauncherMenuButton
                        android:id="@+id/edit_profile_button"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_button_secondary"
                        android:drawableStart="@drawable/ic_px_edit"
                        android:text="Edit"
                        android:textColor="@color/primary_text"
                        android:textSize="10sp" />

                    <com.kdt.mcgui.LauncherMenuButton
                        android:id="@+id/duplicate_instance_button"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_button_secondary"
                        android:drawableStart="@drawable/ic_px_duplicate"
                        android:text="Duplicate"
                        android:textColor="@color/primary_text"
                        android:textSize="10sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:orientation="horizontal">

                    <com.kdt.mcgui.LauncherMenuButton
                        android:id="@+id/delete_instance_button"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_button_secondary"
                        android:drawableStart="@drawable/ic_px_trash"
                        android:text="Delete"
                        android:textColor="@color/primary_text"
                        android:textSize="10sp" />

                    <com.kdt.mcgui.LauncherMenuButton
                        android:id="@+id/open_files_button"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_button_secondary"
                        android:drawableStart="@drawable/ic_px_folder"
                        android:text="Open folder"
                        android:textColor="@color/primary_text"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/instance_count_text"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageButton
                android:id="@+id/create_instance_button"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <View
                android:id="@+id/_background_display_view"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>

    <!-- Floating Cryonix Assistant Circle (Bottom Right) -->
    <ImageButton
        android:id="@+id/floating_assistant_button"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="6dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_floating_assistant"
        android:contentDescription="Cryonix Assistant"
        android:elevation="6dp"
        android:padding="10dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_px_sparkles"
        app:tint="@color/primary_text"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
