<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fragment_launcher_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app">

    <!-- ================================================================= -->
    <!--  1. TOP HEADER BAR                                                -->
    <!-- ================================================================= -->
    <LinearLayout
        android:id="@+id/home_header"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:background="@color/background_secondary"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Top Left: Profile Avatar + Username -->
        <LinearLayout
            android:id="@+id/sidebar_accounts_button"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/profile_avatar"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:contentDescription="Account Avatar"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_head" />

            <TextView
                android:id="@+id/user_profile_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="#F4F7FC"
                android:textSize="15sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="6dp"
                android:contentDescription="@null"
                android:src="@drawable/spinner_arrow"
                app:tint="@color/secondary_text" />
        </LinearLayout>

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

    </LinearLayout>

    <!-- Top Bar Divider Line -->
    <View
        android:id="@+id/header_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider"
        app:layout_constraintTop_toBottomOf="@id/home_header" />

    <!-- ================================================================= -->
    <!--  2. ROUNDED LEFT SIDEBAR (CONTAINS ONLY THE 4 ACTION ICONS)      -->
    <!-- ================================================================= -->

    <!-- ================================================================= -->
    <!--  3. MAIN CONTENT AREA (Left: Instances Manager, Right: Launch Card)-->
    <!-- ================================================================= -->
    <LinearLayout
        android:id="@+id/launcher_sidebar"
        android:layout_width="56dp"
        android:layout_height="299dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_launch_card_dark"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingVertical="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header_divider">

        <!-- 1. Downloads -->
        <ImageButton
            android:id="@+id/sidebar_downloads"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Downloads"
            android:padding="8dp"
            android:src="@drawable/ic_px_download"
            app:tint="#F4F7FC" />

        <!-- 2. Folder / Files -->
        <ImageButton
            android:id="@+id/open_files_button"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginTop="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Files"
            android:padding="8dp"
            android:src="@drawable/ic_px_folder"
            app:tint="#F4F7FC" />

        <!-- 3. Controls -->
        <ImageButton
            android:id="@+id/custom_control_button"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginTop="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Controls"
            android:padding="8dp"
            android:src="@drawable/ic_clean_gamepad"
            app:tint="#F4F7FC" />

        <!-- 4. Screen Recorder -->
        <ImageButton
            android:id="@+id/screen_recorder_button"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginTop="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Screen Recorder"
            android:padding="8dp"
            android:src="@drawable/ic_screen_recoder"
            app:tint="#F4F7FC" />

        <!-- 5. Settings -->
        <ImageButton
            android:id="@+id/sidebar_settings_button"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginTop="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Settings"
            android:padding="8dp"
            android:src="@drawable/ic_clean_settings"
            app:tint="#F4F7FC" />

    </LinearLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main_content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/launcher_sidebar"
        app:layout_constraintTop_toBottomOf="@id/header_divider">

        <!-- ============================================================= -->
        <!--  LEFT SIDE: INSTANCES MANAGER                                 -->
        <!-- ============================================================= -->
        <LinearLayout
            android:id="@+id/left_column"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginEnd="16dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/selected_instance_panel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Instances Section Header Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingBottom="10dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/instances_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-bold"
                        android:text="Instances"
                        android:textColor="#F4F7FC"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="instances"
                        android:textColor="#9BA8BA"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Counter Badge -->
                <TextView
                    android:id="@+id/instance_counter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="1/1"
                    android:textColor="#168BFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- Prev Arrow Button -->
                <ImageButton
                    android:id="@+id/btn_prev_instance"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_button_secondary"
                    android:contentDescription="Previous instance"
                    android:padding="6dp"
                    android:src="@drawable/ic_launcher_chevron_left"
                    app:tint="#F4F7FC" />

                <!-- Next Arrow Button -->
                <ImageButton
                    android:id="@+id/btn_next_instance"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_button_secondary"
                    android:contentDescription="Next instance"
                    android:padding="6dp"
                    android:src="@drawable/ic_launcher_chevron_right"
                    app:tint="#F4F7FC" />

                <!-- Blue Plus Create Instance Button -->
                <ImageButton
                    android:id="@+id/create_instance_button"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_settings_category_selected"
                    android:contentDescription="Create instance"
                    android:padding="7dp"
                    android:src="@drawable/ic_add"
                    app:tint="#F4F7FC" />

            </LinearLayout>

            <!-- Instances List (RecyclerView for created instances) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/instances_list"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:scrollbars="vertical"
                tools:listitem="@layout/item_instance" />

            <!-- Empty State View (Shown when no instances exist) -->
            <LinearLayout
                android:id="@+id/empty_instances_view"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/cryonix_card"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_crystal_logo"
                    app:tint="#168BFF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="No instances found."
                    android:textColor="#9BA8BA"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btn_create_first_instance"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_settings_category_selected"
                    android:text="+ Create Instance"
                    android:textAllCaps="false"
                    android:textColor="#F4F7FC"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- AI Assistant Card (Bottom left) -->

        </LinearLayout>

        <!-- ============================================================= -->
        <!--  RIGHT SIDE: LAUNCH CARD                                      -->
        <!-- ============================================================= -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/selected_instance_panel"
            android:layout_width="244dp"
            android:layout_height="323dp"
            android:background="@drawable/bg_launch_card_dark"
            android:padding="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.0">

            <!-- Center Artwork: Player Head / Skin graphic -->
            <ImageView
                android:id="@+id/selected_instance_preview"
                android:layout_width="86dp"
                android:layout_height="86dp"
                android:contentDescription="Player Head"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_head"
                app:layout_constraintBottom_toTopOf="@+id/instance_info_row"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.4" />

            <!-- Instance Information Row (Near Bottom) -->
            <LinearLayout
                android:id="@+id/instance_info_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintBottom_toTopOf="@id/play_button">

                <!-- Cube Icon -->
                <ImageView
                    android:id="@+id/instance_cube_icon"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:contentDescription="Cube"
                    android:src="@drawable/ic_crystal_logo"/>

                <!-- Title & Subtitle column -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/selected_instance_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-bold"
                        android:singleLine="true"
                        android:text="1.12.2"
                        android:textColor="#F4F7FC"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/selected_instance_version"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="1.12.2"
                        android:textColor="#9BA8BA"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Options / Gear Button -->
                <ImageButton
                    android:id="@+id/edit_profile_button"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Instance Options"
                    android:padding="6dp"
                    android:src="@drawable/ic_clean_settings"
                    app:tint="#F4F7FC" />

            </LinearLayout>

            <!-- Prominent Light Rounded Launch Button -->
            <Button
                android:id="@+id/play_button"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_launch_light"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:stateListAnimator="@null"
                android:text="Launch"
                android:textAllCaps="false"
                android:textColor="#1A1A1A"
                android:textSize="16sp"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ================================================================= -->
    <!--  HIDDEN BACKWARD-COMPATIBLE VIEWS (Required for MainMenuFragment) -->
    <!-- ================================================================= -->
    <LinearLayout
        android:id="@+id/hidden_views_container"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.kdt.mcgui.mcVersionSpinner
            android:id="@+id/mc_version_spinner"
            android:layout_width="1dp"
            android:layout_height="1dp" />

        <ImageButton
            android:id="@+id/setting_button"
            android:layout_width="1dp"
            android:layout_height="1dp" />

        <ImageButton
            android:id="@+id/sidebar_home"
            android:layout_width="1dp"
            android:layout_height="1dp" />

        <ImageButton
            android:id="@+id/sidebar_instances"
            android:layout_width="1dp"
            android:layout_height="1dp" />

        <ImageButton
            android:id="@+id/sidebar_mods"
            android:layout_width="1dp"
            android:layout_height="1dp" />

        <ImageButton
            android:id="@+id/install_jar_button"
            android:layout_width="1dp"
            android:layout_height="1dp" />

        <Button
            android:id="@+id/right_launch_button"
            android:layout_width="1dp"
            android:layout_height="1dp" />

        <Button
            android:id="@+id/btn_manage_instance"
            android:layout_width="1dp"
            android:layout_height="1dp" />

        <Button
            android:id="@+id/duplicate_instance_button"
            android:layout_width="1dp"
            android:layout_height="1dp" />

        <Button
            android:id="@+id/delete_instance_button"
            android:layout_width="1dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/btn_view_all_instances"
            android:layout_width="1dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/btn_view_all_tasks"
            android:layout_width="1dp"
            android:layout_height="1dp" />

        <Button
            android:id="@+id/discord_button"
            android:layout_width="1dp"
            android:layout_height="1dp" />

        <Button
            android:id="@+id/youtube_button"
            android:layout_width="1dp"
            android:layout_height="1dp" />

        <View
            android:id="@+id/card_instances_selector"
            android:layout_width="1dp"
            android:layout_height="1dp" />

        <View
            android:id="@+id/instances_panel"
            android:layout_width="1dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/selected_instance_status"
            android:layout_width="1dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/featured_instance_title"
            android:layout_width="1dp"
            android:layout_height="1dp" />

        <View
            android:id="@+id/manage_account_button"
            android:layout_width="1dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/profile_name"
            android:layout_width="1dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/current_instance_label"
            android:layout_width="1dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/instance_count_text"
            android:layout_width="1dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/task_status_text"
            android:layout_width="1dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/task_count_badge"
            android:layout_width="1dp"
            android:layout_height="1dp" />

        <View
            android:id="@+id/btn_toggle_instances"
            android:layout_width="1dp"
            android:layout_height="1dp" />

        <View
            android:id="@+id/launch_add_account"
            android:layout_width="1dp"
            android:layout_height="1dp" />

        <View
            android:id="@+id/floating_assistant_button"
            android:layout_width="1dp"
            android:layout_height="1dp" />

        <View
            android:id="@+id/ai_assistant_card"
            android:layout_width="1dp"
            android:layout_height="1dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
